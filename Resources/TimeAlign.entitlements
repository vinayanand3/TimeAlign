<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Mac App Store build only (appstore.sh). The app needs nothing beyond the sandbox itself:
     no network, no files outside its bundle and container. -->
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
</dict>
</plist>
